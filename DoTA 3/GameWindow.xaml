<Window x:Class="DoTA_3.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DoTA Clicker — Игра" Height="400" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Левая часть: враг -->
        <StackPanel Margin="10,10,0,0" HorizontalAlignment="Left" Width="200">
            <TextBlock Text="Имя врага:" FontWeight="Bold"/>
            <TextBlock Name="EnemyNameText"/>

            <TextBlock Text="HP врага:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Name="EnemyHPText"/>

            <TextBlock Text="Награда за победу:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Name="EnemyGoldText"/>
        </StackPanel>

        <!-- Центр: иконка врага -->
        <Image Name="EnemyIconImage"
               Width="150" Height="150"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               MouseLeftButtonDown="EnemyIcon_Click"
               Cursor="Hand"/>

        <!-- Правая часть: игрок -->
        <StackPanel Margin="0,10,10,0" HorizontalAlignment="Right" Width="200">
            <TextBlock Text="Ваше золото:" FontWeight="Bold"/>
            <TextBlock Name="PlayerGoldText"/>

            <TextBlock Text="DMG:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Name="PlayerDamageText"/>

            <TextBlock Text="LVL:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Name="LevelText"/>

            <TextBlock Text="Стоимость улучшения:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock Name="UpgradeCostText"/>

            <Button Content="Улучшить" Name="BtnUpgrade"
                    Click="BtnUpgrade_Click"
                    Margin="0,10,0,0" Width="100"/>
        </StackPanel>
    </Grid>
</Window>